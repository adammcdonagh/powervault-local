# ============================================================
# Powervault P3 — Standalone Controller Configuration
# Copy to .env and fill in your values.
# ============================================================

# --- Home Assistant MQTT Broker ---
# This is YOUR HA MQTT broker (e.g. the Mosquitto add-on).
HA_MQTT_HOST=192.168.1.6
HA_MQTT_PORT=1883
HA_MQTT_USER=
HA_MQTT_PASS=

# --- Controller Identity ---
# Short identifier used as a prefix in all published MQTT topics.
# Sensors will appear under: powervault/<DEVICE_ID>/sensor/<name>/state
DEVICE_ID=powervault

# How often to poll hardware and push updates to HA (seconds).
POLL_INTERVAL=30

# --- Iconica Inverter (Voltronic InfiniSolar E 5.5 kW — P18 protocol) ---
# Two connection options:
#   1. USB HID port on the inverter front panel → /dev/hidraw0
#      Set INVERTER_IS_USB=true
#   2. RS-232 / USB-serial adapter → /dev/ttyUSB0
#      Set INVERTER_IS_USB=false (default)
# IMPORTANT: Use a USB isolator between the Pi and inverter to protect hardware.
INVERTER_PORT=/dev/ttyUSB0
INVERTER_IS_USB=false

# --- Pylontech Battery Stack (RS485 via USB-RS485 adapter) ---
# Wire the USB-RS485 adapter to the RJ11/RJ12 RS485 port on the master battery:
#   Pin 7 = RS485-A (positive)
#   Pin 8 = RS485-B (negative)
# DIP switch 1 on the master battery must be OFF to select 115200 baud.
BATTERY_PORT=/dev/ttyUSB1
# Number of Pylontech modules in the stack (addresses 0 … N-1).
NUM_BATTERY_MODULES=1

# --- PV Generation (optional — use one of the two options below) ---

# Option A: ABB UNO PVI 3.0 solar inverter via RS485 (Aurora protocol).
# Wire to the RS485 terminals (A+/B-/GND) on the inverter.
# Default RS485 address is 2; factory baud rate is 19200.
# Leave blank to disable direct RS485 polling.
PV_INVERTER_PORT=
PV_INVERTER_ADDRESS=2

# Option B: External MQTT topic publishing PV AC power in watts.
# Accepts a plain float string ("1500.0") or JSON with a power key
# ("apower", "act_power", "power", etc. — same format as Shelly devices).
# When set, this takes priority and PV_INVERTER_PORT is ignored.
# Example (Shelly PM Mini or similar): shellies/shellypm-aabbcc/status/switch:0
# Leave blank to disable MQTT-based PV reading.
PV_GENERATION_TOPIC=

# --- Shelly EM grid-power integration ---
# Set to the MQTT topic your Shelly EM publishes active power on for channel 0.
# Gen1 example:    shellies/shellyem-aabbcc/emeter/0/power   (plain float W)
# Gen2/Gen3 example: shellyplusem-aabbcc/status/em:0         (JSON payload)
# Leave blank to disable Shelly integration.
SHELLY_GRID_POWER_TOPIC=

# Optional second CT clamp (e.g. two fuse boards — grid power = ch1 + ch2).
# Gen1 example: shellies/shellyem-aabbcc/emeter/1/power
SHELLY_GRID_POWER_TOPIC_2=

# --- Peak-shaving (requires SHELLY_GRID_POWER_TOPIC) ---
# When enabled, the controller automatically overrides the HA-selected mode
# with "discharge" whenever grid import exceeds the threshold, so the battery
# covers the spike without pulling from the grid.
PEAK_SHAVE_ENABLED=false
# Grid import in watts above which battery discharge is triggered (default 0 W).
PEAK_SHAVE_IMPORT_W=0
# Deadband in watts to prevent rapid mode toggling near the threshold (default 50 W).
PEAK_SHAVE_HYSTERESIS_W=50
# Minimum seconds between fast-path inverter commands (default 2 s).
PEAK_SHAVE_MIN_APPLY_INTERVAL=2

# --- Logging ---
LOG_LEVEL=INFO

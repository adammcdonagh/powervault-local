# --- Powervault P3 MQTT Broker (read-only) ---
# The IP address of your Powervault P3 on your local network.
# Find it in your router's DHCP client list (MAC prefix 00:1F:7B).
# Only needed if still running the pv3_monitor bridge alongside the controller.
P3_HOST=192.168.1.215
P3_MQTT_PORT=1883

# The device ID embedded in all MQTT topics.
# Subscribe to pv/PV3/+/# and watch for the ID in the first message.
P3_DEVICE_ID=PV001001DEV

# --- Home Assistant MQTT Broker ---
# This is YOUR HA MQTT broker (e.g. Mosquitto add-on).
HA_MQTT_HOST=192.168.1.6
HA_MQTT_PORT=1883
HA_MQTT_USER=
HA_MQTT_PASS=

# --- M4-Bypass Controller (controller/main.py) ---
# A short identifier used as the prefix in all published MQTT topics.
DEVICE_ID=powervault

# Iconica inverter serial port.
#   USB HID port  → /dev/hidraw0  (set INVERTER_IS_USB=true)
#   USB serial    → /dev/ttyUSB0  (set INVERTER_IS_USB=false)
# IMPORTANT: Use a USB isolator between the Pi and inverter to protect hardware.
INVERTER_PORT=/dev/ttyUSB0
INVERTER_IS_USB=false

# Pylontech US2000C battery stack — RS485 via USB-RS485 adapter.
# Wire the USB-RS485 adapter to the RJ11/RJ12 RS485 port on the master battery:
#   Pin 7 = RS485-A (positive)
#   Pin 8 = RS485-B (negative)
# DIP switch 1 on the master battery must be OFF to select 115200 baud.
# The Console port (RS232) and Contact port (dry relay) are NOT used here.
BATTERY_PORT=/dev/ttyUSB1
# Number of Pylontech modules in the stack. Addresses are 0 … N-1.
NUM_BATTERY_MODULES=1

# ABB UNO PVI 3.0 solar inverter — Aurora RS485 protocol via USB-RS485 adapter.
# Wire to the RS485 terminals on the inverter (A+/B-/GND).
# Default inverter RS485 address is 2; factory baud rate is 19200.
# Leave blank to disable PV inverter polling.
PV_INVERTER_PORT=/dev/ttyUSB2
PV_INVERTER_ADDRESS=2

# How often to poll all hardware and update HA (seconds).
POLL_INTERVAL=30

# --- SSH Schedule Control (legacy — only needed while M4 is still running) ---
# Required only when using the pv3_monitor bridge alongside the M4.
# Leave blank once fully switched to the standalone controller.
M4_SSH_HOST=192.168.1.215
M4_SSH_PORT=22
M4_SSH_USER=root
M4_SSH_KEY_FILE=
M4_KNOWN_HOSTS_FILE=

# --- Logging ---
LOG_LEVEL=INFO

# --- Shelly EM grid-power integration ---
# Set to the MQTT topic your Shelly EM device publishes active grid power on
# for channel 0 (the first CT clamp).
# Examples:
#   Gen1 EM:    shellies/shellyem-aabbcc/emeter/0/power
#   Gen2/Gen3:  shellyplusem-aabbcc/status/em:0   (JSON payload)
# Leave blank to disable Shelly integration.
SHELLY_GRID_POWER_TOPIC=

# Optional second CT clamp channel (e.g. if you have CT clamps on two fuse boards).
# When set, grid power = emeter/0/power + emeter/1/power (both channels summed).
# Example: shellies/shellyem-aabbcc/emeter/1/power
SHELLY_GRID_POWER_TOPIC_2=

# --- Peak-shaving (requires SHELLY_GRID_POWER_TOPIC) ---
# When enabled, the controller automatically overrides the HA-selected mode
# with "discharge" whenever grid import exceeds the threshold, so the battery
# covers the spike without pulling from the grid.
PEAK_SHAVE_ENABLED=false
# Grid import in watts above which battery discharge is triggered (default 0 W).
PEAK_SHAVE_IMPORT_W=0
# Deadband in watts to prevent rapid mode toggling near the threshold (default 50 W).
PEAK_SHAVE_HYSTERESIS_W=50
# Minimum seconds between fast-path inverter commands (default 2 s).
PEAK_SHAVE_MIN_APPLY_INTERVAL=2

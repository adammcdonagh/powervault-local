# --- Powervault P3 MQTT Broker (read-only) ---
# The IP address of your Powervault P3 on your local network.
# Find it in your router's DHCP client list (MAC prefix 00:1F:7B).
P3_HOST=192.168.1.215
P3_MQTT_PORT=1883

# The device ID embedded in all MQTT topics.
# Subscribe to pv/PV3/+/# and watch for the ID in the first message.
P3_DEVICE_ID=PV001001DEV

# --- Home Assistant MQTT Broker ---
# This is YOUR HA MQTT broker (e.g. Mosquitto add-on).
# The bridge connects to BOTH the P3 broker (to read) and this broker (to publish).
HA_MQTT_HOST=192.168.1.6
HA_MQTT_PORT=1883
HA_MQTT_USER=
HA_MQTT_PASS=

# --- Schedule Control via SSH ---
# Required only for charge/discharge control (SSH into the M4 controller).
# Leave blank until you have confirmed SSH access to the M4.
M4_SSH_HOST=192.168.1.215
M4_SSH_PORT=22
M4_SSH_USER=root
# Path to an SSH private key file. Leave blank to use SSH agent or password auth.
M4_SSH_KEY_FILE=
# Path to a known_hosts file containing the M4's host key.
# If blank, the system known_hosts (~/.ssh/known_hosts) is used.
# Add the M4's host key with: ssh-keyscan -H <M4_IP> >> ~/.ssh/known_hosts
M4_KNOWN_HOSTS_FILE=

# --- Logging ---
LOG_LEVEL=INFO
